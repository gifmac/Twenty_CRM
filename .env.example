COMPOSE_PROJECT_NAME=prodata_twenty_test
TAG=v2.17.0

SERVER_URL=http://localhost:3000

PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=<GENERATE_STRONG_PASSWORD_WITHOUT_SPECIAL_CHARACTERS>
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

REDIS_URL=redis://redis:6379

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=<GENERATE_AND_STORE_SECURELY>
FALLBACK_ENCRYPTION_KEY=
APP_SECRET=

STORAGE_TYPE=local

# Phase 2 target after Cloudflare Access is configured:
# SERVER_URL=https://crm-test.proeduconnect.com
